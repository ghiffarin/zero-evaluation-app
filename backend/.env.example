# Database
DATABASE_URL="postgresql://user:password@localhost:5432/pd_os?schema=public"
# Used by Prisma Migrate. Locally it is the same as DATABASE_URL.
DIRECT_URL="postgresql://user:password@localhost:5432/pd_os?schema=public"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# Server
PORT=3001
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL="http://localhost:3000"
