# Database (Supabase). Copy both strings from the dashboard's Connect panel.
# Queries: transaction pooler (port 6543). pgbouncer=true turns off prepared statements.
DATABASE_URL="postgres://postgres.YOUR_PROJECT_ID:YOUR_PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"
# Migrations: session pooler (port 5432).
DIRECT_URL="postgres://postgres.YOUR_PROJECT_ID:YOUR_PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres?sslmode=require"

# JWT - Use a strong secret in production
JWT_SECRET="your-production-jwt-secret-min-32-chars"
JWT_EXPIRES_IN="7d"

# Server
PORT=3001
NODE_ENV=production

# Set to "true" only while creating your account, then back to "false"
ALLOW_REGISTRATION="false"

# Frontend URL (for CORS) - Update with your Vercel URL
FRONTEND_URL="https://your-app.vercel.app"
